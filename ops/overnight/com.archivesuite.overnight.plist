<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.archivesuite.overnight</string>

  <!-- Runs the SAME daemon script (a long-lived loop). Script lives OUTSIDE ~/Desktop so launchd's
       TCC context can exec it (the prior under-Desktop attempt died: "Operation not permitted"). -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/<user>/.local/bin/archive-suite-overnight.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Only restart if it dies unexpectedly; a clean exit (plan COMPLETE) stays stopped. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/<user>/.local/state/archive-overnight/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/<user>/.local/state/archive-overnight/launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
