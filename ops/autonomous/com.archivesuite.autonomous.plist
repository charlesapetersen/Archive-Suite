<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.archivesuite.autonomous</string>

  <!-- Runs the SAME daemon script (a long-lived loop). Script lives OUTSIDE ~/Desktop so launchd's
       TCC context can exec it (the prior under-Desktop attempt died: "Operation not permitted"). -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/<user>/.local/bin/archive-suite-autonomous.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- KeepAlive=true: the ONLY thing that stops the daemon is a `launchctl bootout` — which every INTENTIONAL
       stop performs (park_run, plan COMPLETE, and `arm.sh stop`). Any OTHER death (crash, OOM, a stray
       SIGTERM/SIGKILL) leaves the job registered, so launchd relaunches it. Deliberately NOT
       {SuccessfulExit:false}: the daemon traps SIGTERM/INT and exits 0, so a stray TERM would look
       "successful" and NOT restart — exactly the death observed 2026-07-17 (daemon TERMed mid-session,
       nothing restarted it). KeepAlive=true makes any bootout-less death restart, closing that gap. -->
  <key>KeepAlive</key>
  <true/>

  <!-- Don't hammer on a startup crash-loop: wait 60s between (re)launches. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>/Users/<user>/.local/state/archive-autonomous/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/<user>/.local/state/archive-autonomous/launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
