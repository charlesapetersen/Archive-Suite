# Xcode — the .xcodeproj is generated by XcodeGen (project.yml is authoritative).
# Do NOT commit it. After cloning, run ./bootstrap.sh (or `xcodegen generate`) first.
*.xcodeproj/
DerivedData/
build/

# macOS
.DS_Store
*.swp
*~

# Test files — a large, irreplaceable corpus. Never version-controlled, never modified.
Test files/
Test Files/

# Xcode user state
**/xcuserdata/
*.xcuserstate

# App content index / caches — disposable, rebuildable from the corpus.
*.arindex
ContentIndex/

# Transient maintenance/resume state (session working files)
.maintenance/
