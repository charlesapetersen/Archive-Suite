# Archive Suite — root .gitignore (each app also has its own, covering its build/xcodeproj/etc.)

# macOS
.DS_Store
*.swp
*~

# Build artifacts — apps build under their own subdir; belt-and-suspenders at root too.
build/
DerivedData/
*.xcodeproj/
**/xcuserdata/
*.xcuserstate
# SwiftPM build dir (ArchiveCore package).
.build/

# Release artifacts — the combined DMG is a build output; NEVER commit it.
release/*.dmg
*.dmg

# Transient per-app maintenance / resume state (session working files).
.maintenance/

# Doc-sync backstop one-shot ack (see .claude/hooks/docsync-guard.sh). Lives at the repo ROOT, not in
# .claude/, because the model must be able to create it and tool writes under .claude/ are refused as a
# sensitive path — which auto-denies for the unattended daemon. Per-machine, per-session; never committed.
.docsync-ok

# Local test corpora — large, irreplaceable image collections; never version-controlled, never modified.
Test files/
Test Files/
Test Outputs/

# API keys
*.env

# Archived/irrelevant untracked scratch docs (completed-run review reports, etc.) — see old/README.md.
old/

# Python bytecode. `ArchiveProcessor/scripts/*.py` are imported as modules by the test oracles
# (finder_tags.py by tier2_assert.py / test-finder-tags.sh), so CPython writes it into the source
# tree. The health gate also sets PYTHONDONTWRITEBYTECODE=1 for that step — belt and braces, since
# a gate run must not dirty the checkout it is judging (W26.lint-fu, 2026-08-07).
__pycache__/
