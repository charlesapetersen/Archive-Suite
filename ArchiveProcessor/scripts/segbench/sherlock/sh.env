# Sherlock runtime for the W46 corpus jobs (regions, dewarp, loops, logprob, enh-ocr-input). Source it on the login
# node before a submit script; sbatch exports it, and each job script sources it again through FS_ENV.
# vLLM 0.31 runs in its own CUDA 12.9 image under Apptainer: Sherlock's CentOS 7 (glibc 2.17) cannot take the pip
# wheels FarmShare used. $SCRATCH is /scratch/users/cp1 on both clusters, so with the packs staged in $SCRATCH/fs-ocr
# and the models in $SCRATCH/fs-ocr/hf every absolute path in the packs resolves as it did on FarmShare.
# Rules: execution-plans/sherlock-access.md (environments and images in $GROUP_HOME, job I/O in $SCRATCH).
SH_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SH_DIR FS_ENV="$SH_DIR/sh.env" FS_CONTAINER=1
export FS_ROOT="$SCRATCH/fs-ocr" HF_HOME="$SCRATCH/fs-ocr/hf"
export SH_IMG="$GROUP_HOME/$USER/images/vllm-0.31.0-cu129.sif" SH_SHIM="$GROUP_HOME/$USER/images/pyshim"
export FS_PY="$SH_DIR/bin/py" FS_VLLM="$SH_DIR/bin/vllm"
# PP-OCRv6 (engine=transformers) in a --system-site-packages venv over the image, FarmShare's overlay rebuilt by
# setup-ppocr-job.sh; the image's torch 2.13 cu129 stays underneath.
export SH_PPOCR_ENV="$GROUP_HOME/$USER/envs/ppocrv6" FS_PPOCR_PY="$SH_DIR/bin/ppocr-py"
# What the enhancement arms need beyond the pack's pydeps that FarmShare's venv carried (scipy, albumentations, ...):
# a --system-site-packages venv over the image, built by fix-20261023-job.sh; enh-ocr-job.sh puts its site-packages
# after pydeps.
export SH_ENH_ENV="$GROUP_HOME/$USER/envs/enh-overlay"
export SH_ENH_EXTRA="$SH_ENH_ENV/lib/python3.12/site-packages"
# The cards the FarmShare runs used (L40S, 48 GB) or larger; Sherlock selects hardware by feature, never --exclude.
export SH_GPU_C="GPU_MEM:48GB|GPU_MEM:80GB"
